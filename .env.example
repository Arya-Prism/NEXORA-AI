# ==========================================================
# NEXORA AI - Environment Variables Reference Guide
# Copy this file to .env in your root directory and fill in your keys.
# ==========================================================

# ----------------------------------------------------------
# 1. SERVER CONFIGURATION
# ----------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ----------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH CONFIGURATION
# Obtain from: https://app.supabase.com -> Project Settings -> API
# ----------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (used for client-side queries and user auth)
SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Secret Key (used server-side for administrative tasks and bypassing RLS when safe)
# IMPORTANT: Keep this secret; never expose it in client code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------
# 3. OPENAI API INTEGRATION
# Obtain from: https://platform.openai.com/api-keys
# ----------------------------------------------------------
# Your OpenAI Secret API Key (starts with sk-...)
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI Model Selection (defaults to gpt-4o-mini for fast, cost-efficient inference)
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# 4. STORAGE & LIMITS
# ----------------------------------------------------------
MAX_FILE_SIZE_MB=10
